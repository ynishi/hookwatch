{
  "jigs": [
    {
      "id": "term-shadow-md",
      "description": "Markdown prose writes the lifecycle term as Shadow (rework 2026-11-14)",
      "rule": {
        "kind": "command",
        "argv": [
          "python3",
          "-I",
          "$HOME/projects/hookwatch/jigs/term_shadow_md.py"
        ],
        "timeout_ms": 2000
      },
      "action": "nudge",
      "lifecycle": "enforce",
      "message": "用語は Shadow と表記する (人の直し 2026-11-14)",
      "when": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "\\.md$"
      }
    },
    {
      "id": "term-shadow-md-v2",
      "description": "Markdown sentences write the lifecycle term as Shadow; values stay lowercase",
      "rule": {
        "kind": "command",
        "argv": [
          "python3",
          "-I",
          "$HOME/projects/hookwatch/jigs/term_shadow_md_v2.py"
        ],
        "timeout_ms": 2000
      },
      "action": "nudge",
      "lifecycle": "shadow",
      "message": "用語は文の中では Shadow と表記する (人の直し 2026-11-14)",
      "when": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ],
        "path": "\\.md$"
      }
    },
    {
      "id": "test-weakening",
      "description": "an edit of a test that removes assertions or adds skip / ignore",
      "rule": {
        "kind": "command",
        "argv": [
          "python3",
          "-I",
          "$HOME/projects/hookwatch/jigs/tests_weakened.py"
        ],
        "timeout_ms": 2000
      },
      "action": "block",
      "lifecycle": "shadow",
      "message": "This edit weakens a test (fewer assertions or a new skip). Fix the code under test, not the test.",
      "when": {
        "tools": [
          "Write",
          "Edit",
          "MultiEdit"
        ]
      }
    },
    {
      "id": "hotspots",
      "description": "scripts written and run again and again: candidates for a canonical tool",
      "rule": {
        "kind": "command",
        "argv": [
          "python3",
          "-I",
          "$HOME/projects/hookwatch/jigs/hotspots.py"
        ],
        "timeout_ms": 5000
      },
      "action": "nudge",
      "lifecycle": "shadow",
      "message": "These scripts keep being written and run: make each a canonical tool (tools/ + test) or say why not",
      "when": {
        "events": [
          "Stop"
        ]
      },
      "repeat": "once"
    }
  ],
  "lifecycle": {
    "term-shadow-md": "retired"
  }
}
